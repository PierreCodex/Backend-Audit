# API de Claude (obligatorio en Railway)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# POS Laravel (local XAMPP en desarrollo, Railway en producción)
# Para la demo del ESP32 → Web sin POS real, dejar USE_MOCK_POS=true
POS_URL=http://localhost/SistemaPosV2/public
POS_TOKEN=token_emitido_por_artisan_integracion_generar-token-python
USE_MOCK_POS=true

# Auth ESP32 → backend Python (debe coincidir con secrets.h del firmware)
ESP32_API_TOKEN=EA16BA4F423CDE9FD8A5A154EED7B1815A5B5EBC42762D816D6B4A3513A4D5C7

# Servidor
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Umbrales de negocio
CONFIANZA_MINIMA=0.70

# Debug — guarda imágenes recibidas en STORAGE_PATH/debug/ para que la web las muestre
DEBUG_GUARDAR_CAPTURAS=true
STORAGE_PATH=./storage

# Control de costos: true = Claude analiza automáticamente cada foto del ESP32
# (gasta tokens, ideal para demos). false = guarda imagen pero NO analiza.
ANALISIS_AUTOMATICO=true